# Secrets — never commit
.env
keys.txt

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/
ENV/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Archive (old scripts, stale data — local only, never push)
archive/

# Model artifacts (generated by train.py — large binaries)
models/

# Data (regenerated by research.py / refresh_etf_data.py)
data/

# Signals (regenerated by pipeline each run)
signals/*
# But track the live config + walkforward results — GitHub Actions needs
# these on cold cache.  Without them the first run after cache eviction
# fails with "Missing approved live config file".
!signals/core_satellite_live_configs.json
!signals/core_satellite_nested_walkforward.json
!signals/core_satellite_validation_bundle.json
!signals/paper_validation_epoch.json
!signals/adaptive_factor_weights.json
# Feature quality artefacts — track the known-good baseline so GitHub
# Actions starts from a fresh cluster gate even if the morning's
# factor_data_refresh produced a partial report (mid-panel-rebuild).
# These are regenerated by feature_quality_diagnostic.py.
!signals/feature_quality_report.json
!signals/feature_quality_summary.csv
!signals/feature_health_profile.json
!signals/feature_health_profile.csv
!signals/feature_research_report.json
!signals/feature_research_summary.csv
!signals/research_run_manifest.json

# Logs (runtime output — not source code)
logs/*
!logs/factor_decay_monitor.json
!logs/core_satellite_execution_stress.json
!logs/core_satellite_survivorship_audit.json
# Exception: feature_ic_shortlist drives the spec loader and is used by
# the feature quality guard.  Track it so GH Actions has a baseline.
!logs/feature_ic_shortlist.csv

# Jupyter
.ipynb_checkpoints/

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Claude worktrees
.claude/worktrees/

# Backups created by scripts (publish_live_config_from_csv.py creates .bak)
*.bak
*.bak2
*.bak3

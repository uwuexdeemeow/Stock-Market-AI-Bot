# Secrets — never commit
.env
keys.txt

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/
ENV/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Archive (old scripts, stale data — local only, never push)
archive/

# Model artifacts (generated by train.py — large binaries)
models/

# Data (regenerated by research.py / refresh_etf_data.py)
data/

# Signals (regenerated by pipeline each run)
signals/
# But track the live config + walkforward results — GitHub Actions needs
# these on cold cache.  Without them the first run after cache eviction
# fails with "Missing approved live config file".
!signals/core_satellite_live_configs.json
!signals/core_satellite_nested_walkforward.json
!signals/adaptive_factor_weights.json

# Logs (runtime output — not source code)
logs/

# Jupyter
.ipynb_checkpoints/

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Claude worktrees
.claude/worktrees/

# Backups created by scripts (publish_live_config_from_csv.py creates .bak)
*.bak
*.bak2
*.bak3

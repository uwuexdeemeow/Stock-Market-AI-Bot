# ═══════════════════════════════════════════════════════════════════════
# .env.example — copy to `.env` and fill in your values.
# `.env` is gitignored.  Never commit secrets.
# ═══════════════════════════════════════════════════════════════════════

# ── LLM / Research APIs ────────────────────────────────────────────────
# Optional — only needed if running diagnostic LLM steps.
OPENAI_API_KEY=sk-...

# ── Market Data ────────────────────────────────────────────────────────
# Finnhub — free tier covers fundamentals + earnings calendar.
# Sign up: https://finnhub.io
FINNHUB_API_KEY=

# Tradier — free options IV / put-call ratio / IV skew.
# Sign up: https://tradier.com → https://web.tradier.com/user/api
# Set TRADIER_USE_SANDBOX=1 if you don't have a funded brokerage account.
TRADIER_API_TOKEN=
TRADIER_USE_SANDBOX=1

# ── Alpaca Paper Trading (free, commission-free) ───────────────────────
# Sign up: https://app.alpaca.markets/signup → Paper Trading → API Keys
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Optional override — defaults to paper-api.alpaca.markets
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── Moomoo Paper Trading (secondary broker) ────────────────────────────
# Used by moomoo_paper_trading.py. Requires the Moomoo OpenAPI daemon
# running locally (FutuOpenD).
MOOMOO_HOST=127.0.0.1
MOOMOO_PORT=11111
MOOMOO_UNLOCK_PWD=
MOOMOO_MARKET=US
MOOMOO_SECURITY_FIRM=FUTUINC
FUTUINC=

# Moomoo core ETF protection
MOOMOO_CORE_STOP=1
MOOMOO_CORE_STOP_TICKERS=SPY,QQQ,TQQQ
MOOMOO_CORE_STOP_PCT=0.05
MOOMOO_TQQQ_STOP_PCT=0.10
MOOMOO_CORE_STOP_LIMIT_BUFFER_PCT=0.005
MOOMOO_CORE_STOP_REPLACE_BPS=25

# ── Alpaca Execution Guard / Core ETF Protection ───────────────────────
# Broker-side trailing stops that protect SPY/QQQ/TQQQ even when the
# laptop is offline.  execution_guard.py adds stale-order + P&L checks.
GUARD_CORE_STOP=1
GUARD_CORE_TICKERS=SPY,QQQ,TQQQ
GUARD_CORE_TRAIL_PCT=0.05
GUARD_TQQQ_TRAIL_PCT=0.10
GUARD_STALE_CANCEL=1
GUARD_STALE_MINUTES=90
GUARD_PNL_MONITOR=1
GUARD_PNL_WARN_PCT=-3.0
GUARD_PNL_HALT_PCT=-8.0
GUARD_INTERVAL_SEC=300
GUARD_ALERTS=1

# ── Paper Trading Strategy + Health Gauntlet ───────────────────────────
PAPER_MODE_STRATEGY=core_satellite_alpha
PAPER_SIGNAL_TIMEZONE=Asia/Singapore

# Paper gauntlet (alpaca_paper_gauntlet.py) — go-live readiness gates
PAPER_GAUNTLET_MAX_AVG_SLIPPAGE_BPS=10
ALPACA_GAUNTLET_MIN_DAYS=20
ALPACA_GAUNTLET_MIN_SHARPE=0.5
ALPACA_GAUNTLET_MAX_DD=-15
ALPACA_GAUNTLET_MIN_FILL_RATE=0.95
ALPACA_GAUNTLET_MAX_CANCEL_RATE=0.05
ALPACA_GAUNTLET_MAX_DRIFT=0.10
ALPACA_GAUNTLET_MAX_SIGNAL_AGE_HOURS=36

# Paper health (paper_health.py) — daily drift / risk summary
PAPER_HEALTH_MAX_AVG_SLIPPAGE_BPS=10
PAPER_HEALTH_MAX_DRAWDOWN_WARN_PCT=-5
PAPER_HEALTH_CORE_TICKERS=SPY,QQQ,TQQQ
PAPER_HEALTH_MAX_CORE_TICKER_WEIGHT=0.65
PAPER_HEALTH_MAX_TICKER_WEIGHT=0.35
PAPER_HEALTH_MAX_SECTOR_WEIGHT=0.50
PAPER_HEALTH_STALE_OPEN_ORDER_MINUTES=60
PAPER_HEALTH_MAX_EQUITY_DAILY_MOVE_WARN_PCT=25
# Drift detection — when do we warn that live ≠ backtest?
PAPER_HEALTH_DRIFT_MIN_LIVE_DAYS=10
PAPER_HEALTH_DRIFT_SHARPE_WARN_FRAC=0.3
PAPER_HEALTH_DRIFT_CAGR_UNDERPERFORM_PCT=20
PAPER_HEALTH_DRIFT_DD_WARN_MULT=1.5

# ── Live Config / Walkforward ──────────────────────────────────────────
# How old (in days) can the approved live config get before live trading
# is blocked.  Forces periodic walkforward re-validation.
LIVE_CONFIG_MAX_AGE_DAYS=45
# Parallel workers used by core_satellite_nested_walkforward.py.
# Defaults to CPU count - 1.  Bump down on memory-constrained machines.
# WALKFORWARD_WORKERS=4

# ── Universe / Watchlist ───────────────────────────────────────────────
# Which stock universe to use: lean (~60), broad (~147), expanded.
STOCK_UNIVERSE_MODE=lean

# ── Notification Channels ──────────────────────────────────────────────
# Telegram — paste your bot token from @BotFather.
# Send /start to your bot, then visit
# https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Slack — create an Incoming Webhook at https://api.slack.com/apps
SLACK_WEBHOOK_URL=

# Email (SMTP) — for failure alerts.  Gmail requires an App Password
# (not your account password): https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL_FROM=you@gmail.com
ALERT_EMAIL_TO=you@gmail.com

# Master switch — set to 0 to silence ALL alerts (useful for testing).
STOCKBOT_ALERTS_ENABLED=1

# ── Social Sentiment (optional, safety-only by default) ────────────────
# X (Twitter) Bearer Token for cashtag sentiment.
# Get at: https://developer.twitter.com/en/portal/dashboard
SOCIAL_SENTIMENT_SAFETY_ENABLED=1
SOCIAL_SENTIMENT_ALPHA_ENABLED=0
X_BEARER_TOKEN=

# ── Dashboard (Streamlit) ──────────────────────────────────────────────
# GitHub Actions page needs a token to read workflow runs from a PRIVATE
# repo.  Generate at https://github.com/settings/tokens?type=beta
# Permissions: Actions=Read (read-only is enough).
# Public repos work without a token (subject to 60 req/h rate limit).
GITHUB_TOKEN=

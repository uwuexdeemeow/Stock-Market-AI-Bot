# ═══════════════════════════════════════════════════════════════════════
# .env.example — copy to `.env` and fill in your values.
# `.env` is gitignored.  Never commit secrets.
# ═══════════════════════════════════════════════════════════════════════

# ── LLM / Research APIs ────────────────────────────────────────────────
# Optional — only needed if running diagnostic LLM steps.
OPENAI_API_KEY=sk-...

# ── Market Data ────────────────────────────────────────────────────────
# Finnhub — free tier covers fundamentals + earnings calendar.
# Sign up: https://finnhub.io
FINNHUB_API_KEY=

# Tradier — free options IV / put-call ratio / IV skew.
# Sign up: https://tradier.com → https://web.tradier.com/user/api
# Set TRADIER_USE_SANDBOX=1 if you don't have a funded brokerage account.
TRADIER_API_TOKEN=
TRADIER_USE_SANDBOX=1

# ── Alpaca Paper Trading (free, commission-free) ───────────────────────
# Sign up: https://app.alpaca.markets/signup → Paper Trading → API Keys
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Optional override — defaults to paper-api.alpaca.markets
# ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Leave 0.5% of equity as buy-side cash buffer so orders do not spend to zero.
ALPACA_BUY_CASH_BUFFER_PCT=0.005
ALPACA_BUY_CASH_BUFFER_DOLLARS=0
# Fail closed when quotes or TQQQ fast-check data are unavailable.
ALPACA_REQUIRE_QUOTE_FOR_SUBMIT=1
# Legacy setting kept for compatibility. Normal rebalances remain capped
# limits even if an old environment sets this to 1.
ALPACA_ALLOW_MARKET_ORDER_OVERRIDE=0
# Use live bid/ask as the protective limit anchor. Set to `last` to roll back.
ALPACA_LIMIT_REFERENCE=quote
# Small fill cushion added to the quote anchor before submitting day limits.
ALPACA_LIMIT_OFFSET_BPS_ETF=5
ALPACA_LIMIT_OFFSET_BPS_OVERLAY=12
# Balanced execution rests at midpoint, then crosses once with a capped limit.
ALPACA_TWO_STAGE_EXECUTION=1
ALPACA_EXECUTION_STAGE1_WAIT_SECONDS=15
ALPACA_EXECUTION_STAGE_POLL_SECONDS=1
ALPACA_EXECUTION_CANCEL_WAIT_SECONDS=10
ALPACA_EXECUTION_STAGE2_OFFSET_BPS_ETF=1
ALPACA_EXECUTION_STAGE2_OFFSET_BPS_OVERLAY=3
ALPACA_EXECUTION_QUOTE_MAX_AGE_SECONDS=5
ALPACA_EXECUTION_WINDOW_START=09:35
ALPACA_EXECUTION_WINDOW_END=10:30
ALPACA_EXECUTION_SYMBOL_MIN_SAMPLES=5
MAX_SPREAD_PCT_ETF=0.001
MAX_SPREAD_PCT_OVERLAY=0.005
# Recent execution risk is informational; it changes pricing policy, not target size.
ALPACA_EXECUTION_RISK_ENABLED=1
ALPACA_EXECUTION_RISK_REPORT_MAX_AGE_HOURS=168
ALPACA_EXECUTION_RISK_WARN_SCORE=40
ALPACA_EXECUTION_RISK_HIGH_SCORE=60
ALPACA_EXECUTION_RISK_WARN_BUY_SCALE=0.75
ALPACA_EXECUTION_RISK_HIGH_BUY_SCALE=0.50
# Keep reading the portfolio-wide scorecard for audit metadata. It no longer
# silently shrinks approved target quantities.
ALPACA_EXECUTION_SCORECARD_THROTTLE=1
ALPACA_EXECUTION_SCORECARD_MAX_AGE_HOURS=72
ALPACA_EXECUTION_SCORECARD_FAIL_BUY_SCALE=0.75
ALPACA_EXECUTION_SCORECARD_SEVERE_SCORE=50
ALPACA_EXECUTION_SCORECARD_SEVERE_BUY_SCALE=0.50
# Execution scorecard thresholds for judging paper fills after trading.
EXECUTION_SCORECARD_MAX_AVG_SLIPPAGE_BPS=10
EXECUTION_SCORECARD_MAX_BAD_SLIPPAGE_RATE=0.60
EXECUTION_SCORECARD_BAD_SLIPPAGE_BPS=2
EXECUTION_SCORECARD_MIN_FILL_RATE=0.80
EXECUTION_SCORECARD_MAX_SKIPPED_RATE=0.35
EXECUTION_SCORECARD_MAX_ADVERSE_15M_RATE=0.60
EXECUTION_SCORECARD_MAX_ADVERSE_60M_RATE=0.70
EXECUTION_SCORECARD_LOOKBACK_DAYS=30
EXECUTION_SCORECARD_WARN_AVG_SLIPPAGE_BPS=5
EXECUTION_SCORECARD_WARN_BAD_SLIPPAGE_RATE=0.40
EXECUTION_SCORECARD_MIN_REBALANCE_FILLS=20
EXECUTION_SCORECARD_MIN_REBALANCE_SESSIONS=3
# Broker truth reconciliation tolerances.  The daily run still publishes the
# report when it warns/fails; use `python broker_truth.py --strict` to make it
# exit nonzero during manual audits.
BROKER_TRUTH_QTY_TOLERANCE=0.001
BROKER_TRUTH_WEIGHT_TOLERANCE=0.02
BROKER_TRUTH_GROSS_EXPOSURE_TOLERANCE=0.05
BROKER_TRUTH_ALIGNMENT_WAIT_SECONDS=90
BROKER_TRUTH_ALIGNMENT_POLL_SECONDS=5
BROKER_TRUTH_REQUIRE_LIVE_ORDERS=0
# Pre-submit broker truth gate.  If reconciliation fails, skip BUY orders but
# allow SELL orders so the account can reduce risk.
ALPACA_BROKER_TRUTH_GATE=1
ALPACA_BROKER_TRUTH_BLOCK_BUYS_ON_FAIL=1
TQQQ_FAST_DD_FAIL_CLOSED=1
# Suppress repeated identical spread-guard Telegram alerts for this many hours.
SPREAD_GUARD_ALERT_TTL_HOURS=20
# Wait briefly for overlay buys to fill before attaching trailing stops.
ALPACA_BUY_FILL_WAIT_SECONDS=20
ALPACA_BUY_FILL_POLL_SECONDS=2

# ── Alpaca Execution Guard / Core ETF Protection ───────────────────────
# Broker-side trailing stops that protect SPY/QQQ/TQQQ even when the
# laptop is offline.  execution_guard.py adds stale-order + P&L checks.
GUARD_CORE_STOP=1
GUARD_CORE_TICKERS=SPY,QQQ,TQQQ
GUARD_CORE_TRAIL_PCT=0.05
GUARD_TQQQ_TRAIL_PCT=0.10
GUARD_STALE_CANCEL=1
GUARD_STALE_MINUTES=90
GUARD_REPLACE_STALE_SELLS=1
GUARD_REPLACE_STALE_SELL_OFFSET_BPS=20
GUARD_BROKER_TRUTH_REFRESH=1
GUARD_PNL_MONITOR=1
GUARD_PNL_WARN_PCT=-3.0
GUARD_PNL_HALT_PCT=-8.0
GUARD_INTERVAL_SEC=300
GUARD_ALERTS=1

# ── Paper Trading Strategy + Health Gauntlet ───────────────────────────
PAPER_MODE_STRATEGY=core_satellite_alpha
PAPER_SIGNAL_TIMEZONE=Asia/Singapore
MAX_SIGNAL_FUTURE_MINUTES=5

# Paper gauntlet (alpaca_paper_gauntlet.py) — go-live readiness gates
PAPER_GAUNTLET_MAX_AVG_SLIPPAGE_BPS=10
ALPACA_GAUNTLET_MIN_DAYS=20
ALPACA_GAUNTLET_MIN_SHARPE=0.5
ALPACA_GAUNTLET_MAX_DD=-15
ALPACA_GAUNTLET_MIN_FILL_RATE=0.95
ALPACA_GAUNTLET_MAX_CANCEL_RATE=0.05
ALPACA_GAUNTLET_MAX_DRIFT=0.10
ALPACA_GAUNTLET_MAX_SIGNAL_AGE_HOURS=36

# Paper health (paper_health.py) — daily drift / risk summary
PAPER_HEALTH_MAX_AVG_SLIPPAGE_BPS=10
PAPER_HEALTH_MAX_DRAWDOWN_WARN_PCT=-5
PAPER_HEALTH_CORE_TICKERS=SPY,QQQ,TQQQ
PAPER_HEALTH_MAX_CORE_TICKER_WEIGHT=0.65
PAPER_HEALTH_MAX_TICKER_WEIGHT=0.35
PAPER_HEALTH_MAX_SECTOR_WEIGHT=0.50
PAPER_HEALTH_STALE_OPEN_ORDER_MINUTES=60
PAPER_HEALTH_MAX_EQUITY_DAILY_MOVE_WARN_PCT=25
# Drift detection — when do we warn that live ≠ backtest?
PAPER_HEALTH_DRIFT_MIN_LIVE_DAYS=10
PAPER_HEALTH_DRIFT_SHARPE_WARN_FRAC=0.3
PAPER_HEALTH_DRIFT_CAGR_UNDERPERFORM_PCT=20
PAPER_HEALTH_DRIFT_DD_WARN_MULT=1.5

# ── Live Config / Walkforward ──────────────────────────────────────────
# How old (in days) can the approved live config get before live trading
# is blocked.  Forces periodic walkforward re-validation.
LIVE_CONFIG_MAX_AGE_DAYS=45
# Which scoring formula chooses the best walkforward config.
# Options:
#   alpha_vs_qqq  = current default after hybrid A/B came in worse
#   hybrid        = opt-in blend of Sharpe and QQQ alpha
#   sharpe        = original Sharpe-focused objective
ROBUSTNESS_OBJECTIVE=alpha_vs_qqq
# How inner-fold scores are combined before picking a config.
# mean = current default; median = opt-in noise-robust A/B experiment.
WALKFORWARD_INNER_AGG=mean
# Optional A/B: reward stable config families selected in earlier outer folds.
# 0 keeps the old selector; 0.10 is the current family-consensus experiment.
WALKFORWARD_FAMILY_CONSENSUS_BONUS=0
# Inner turnover gates for nested selector. Defaults keep candidates below the
# 600% live-approval turnover gate while allowing the approved stable family.
WALKFORWARD_MAX_INNER_MEAN_TURNOVER_PCT=450
WALKFORWARD_MAX_INNER_WORST_TURNOVER_PCT=550
# Parallel workers used by core_satellite_nested_walkforward.py.
# 1 is safest on Windows; use 2-3 only if RAM stays stable.
WALKFORWARD_WORKERS=1

# ── Universe / Watchlist ───────────────────────────────────────────────
# Which stock universe to use: lean (~60), broad (~147), expanded.
STOCK_UNIVERSE_MODE=lean

# ── Notification Channels ──────────────────────────────────────────────
# Telegram — paste your bot token from @BotFather.
# Send /start to your bot, then visit
# https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Slack — create an Incoming Webhook at https://api.slack.com/apps
SLACK_WEBHOOK_URL=

# Master switch — set to 0 to silence ALL alerts (useful for testing).
STOCKBOT_ALERTS_ENABLED=1

# ── Social Sentiment (optional, safety-only by default) ────────────────
# X (Twitter) Bearer Token for cashtag sentiment.
# Get at: https://developer.twitter.com/en/portal/dashboard
SOCIAL_SENTIMENT_SAFETY_ENABLED=1
SOCIAL_SENTIMENT_ALPHA_ENABLED=0
X_BEARER_TOKEN=

# ── Dashboard (Streamlit) ──────────────────────────────────────────────
# GitHub Actions page needs a token to read workflow runs from a PRIVATE
# repo.  Generate at https://github.com/settings/personal-access-tokens/new
#   • Fine-grained PAT (recommended):
#       Repository access → Only select repositories → pick this repo
#       Repository permissions → Actions → Read-only
#   • Classic PAT (alternate): scope = `repo`
# Public repos work without a token (subject to 60 req/h rate limit).
GITHUB_TOKEN=

OPENAI_API_KEY=sk-...
FINNHUB_API_KEY=...

# ── Alpaca Paper Trading (free, commission-free) ─────────────────────────────
# Sign up at https://app.alpaca.markets/signup → Paper Trading → API Keys
# Also provides intraday minute bars for VWAP features (intraday_features.py)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# ── Alpaca Execution Guard / Core ETF Protection ────────────────────────────
# Broker-side trailing stops protect core ETFs even when the laptop is offline.
# The local execution_guard.py adds stale-order and P&L checks while awake.
GUARD_CORE_STOP=1
GUARD_CORE_TICKERS=SPY,QQQ,TQQQ
GUARD_CORE_TRAIL_PCT=0.05
GUARD_TQQQ_TRAIL_PCT=0.10
GUARD_STALE_CANCEL=1
GUARD_STALE_MINUTES=90
GUARD_PNL_MONITOR=1
GUARD_PNL_WARN_PCT=-3.0
GUARD_PNL_HALT_PCT=-8.0
GUARD_INTERVAL_SEC=300
GUARD_ALERTS=1

# ── Tradier API — free options IV data ───────────────────────────────────────
# Sign up at https://tradier.com (free account), get token at https://web.tradier.com/user/api
# Provides real implied volatility, put/call ratio, IV skew (options_iv_provider.py)
# Set TRADIER_USE_SANDBOX=1 for delayed data without a funded account
TRADIER_API_TOKEN=
TRADIER_USE_SANDBOX=1

# ── Paper trading ─────────────────────────────────────────────────────────────
PAPER_MODE_STRATEGY=core_satellite_alpha
PAPER_SIGNAL_TIMEZONE=Asia/Singapore
PAPER_GAUNTLET_MAX_AVG_SLIPPAGE_BPS=10
PAPER_HEALTH_MAX_AVG_SLIPPAGE_BPS=10
PAPER_HEALTH_MAX_DRAWDOWN_WARN_PCT=-5
PAPER_HEALTH_CORE_TICKERS=SPY,QQQ,TQQQ
PAPER_HEALTH_MAX_CORE_TICKER_WEIGHT=0.65
PAPER_HEALTH_MAX_TICKER_WEIGHT=0.35
PAPER_HEALTH_MAX_SECTOR_WEIGHT=0.50
PAPER_HEALTH_STALE_OPEN_ORDER_MINUTES=60
PAPER_HEALTH_MAX_EQUITY_DAILY_MOVE_WARN_PCT=25

# ── Moomoo Core ETF Protection ───────────────────────────────────────────────
# Moomoo paper trailing stops are unreliable, so the guard uses STOP_LIMIT
# orders when supported. It never falls back to a plain sell limit below market.
MOOMOO_CORE_STOP=1
MOOMOO_CORE_STOP_TICKERS=SPY,QQQ,TQQQ
MOOMOO_CORE_STOP_PCT=0.05
MOOMOO_TQQQ_STOP_PCT=0.10
MOOMOO_CORE_STOP_LIMIT_BUFFER_PCT=0.005
MOOMOO_CORE_STOP_REPLACE_BPS=25

# ── X (Twitter) API — used by social_sentiment.py for cashtag sentiment ───────
# Get a Bearer Token at https://developer.twitter.com/en/portal/dashboard
# Social sentiment is safety-only by default.  It can help live sentiment
# fallback diagnostics, but should not be used as model alpha unless a separate
# validation project proves it is point-in-time and predictive.
SOCIAL_SENTIMENT_SAFETY_ENABLED=1
SOCIAL_SENTIMENT_ALPHA_ENABLED=0
X_BEARER_TOKEN=

# ── monitor.py alert channels (fill in whichever you want to use) ──────────
# Slack: create an Incoming Webhook at https://api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK_URL=

# Email via SMTP (e.g. Gmail with an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL_FROM=you@gmail.com
ALERT_EMAIL_TO=you@gmail.com
